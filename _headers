# Cloudflare Pages custom response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Shared, non-fingerprinted JS and CSS (leaderboard.js, nav.js, footer.js,
# pause-button.js, styles.css, etc.) are loaded by every game page and change
# between deploys. Cloudflare Pages' default of `Cache-Control: max-age=14400`
# lets a browser serve a stale copy for up to 4 hours, which can mask a shipped
# fix — e.g. a game page calling a newly added Leaderboard method that the
# cached script doesn't have yet. Force revalidation instead: the ETag makes it
# a cheap 304 Not Modified when the file is unchanged, but an updated file is
# picked up on the very next load.
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate
